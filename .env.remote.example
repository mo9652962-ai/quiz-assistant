# Phase C remote pilot: FastAPI remains on loopback and Caddy terminates HTTPS.
QUIZ_REMOTE_ENABLED=true
QUIZ_REMOTE_READ_ONLY=true
QUIZ_REMOTE_HOST=127.0.0.1
QUIZ_REMOTE_PORT=8765
QUIZ_REMOTE_PUBLIC_ORIGIN=https://quiz.example.com
QUIZ_REMOTE_TLS_PROXY_ENABLED=true
QUIZ_REMOTE_TRUSTED_PROXY_HOSTS=127.0.0.1
QUIZ_REMOTE_OWNER_USERNAME=
QUIZ_REMOTE_OWNER_PASSWORD=

# Temporary same-host SQLite pilot. Do not use SQLite on a network share.
# Remove this flag and set QUIZ_DATABASE_URL after the PostgreSQL adapter is shipped.
QUIZ_REMOTE_ALLOW_SQLITE=true
QUIZ_DATABASE_URL=
QUIZ_DB_PATH=data/quiz.db

# External AI stays disabled during the read-only pilot.
QUIZ_AI_ENABLED=false
